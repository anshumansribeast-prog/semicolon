# Same reasoning as .gitignore: keep secrets and dev-only cruft out of
# the image. .dockerignore has its own file because Docker doesn't
# read .gitignore automatically.
.git
.env
.env.local
.env.*.local
.netlify/
node_modules/
dist/
build/
*.log
.vscode/
.idea/

# Python cache. ada_server.py is copied into the image on purpose
# (see Dockerfile); it is then removed from the public web root.
__pycache__/
