# ===================================================================
# Semicolon — environment variable template
# ===================================================================
EMAIL_PROVIDER=formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@yourdomain.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=you@yourdomain.com
GA_MEASUREMENT_ID=
GOOGLE_MAPS_API_KEY=

# Ada primary model (server-side only)
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
ADA_VISITOR_NAME=AnshX

# Optional OpenAI second-opinion fallback (server-side only).
# Ada calls this only when the primary model signals genuine uncertainty
# or the primary provider fails. Never put this in frontend JavaScript.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.6-luna

SEMICOLON_ADMIN_TOKEN=
DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
PORT=3000
