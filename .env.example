# ===================================================================
# Semicolon — environment variable template
# ===================================================================
EMAIL_PROVIDER=formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@yourdomain.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=you@yourdomain.com
GA_MEASUREMENT_ID=
GOOGLE_MAPS_API_KEY=

# Ada primary model (server-side only)
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
ADA_VISITOR_NAME=AnshX

# Optional second-model fallback (server-side only).
# The fallback is called only for genuine uncertainty, not every question.
ADA_FALLBACK_API_URL=
ADA_FALLBACK_API_KEY=
ADA_FALLBACK_MODEL=

SEMICOLON_ADMIN_TOKEN=
DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
PORT=3000
