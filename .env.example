# ===================================================================
# Semicolon — environment variable template
#
# HOW TO USE
#   1. Copy this file and rename the copy to  .env
#   2. Fill in the real values
#   3. Make sure .env is listed in .gitignore  ← DO THIS FIRST
#
# WHY THIS FILE EXISTS
#   Secrets must never be typed into js/config.js, because every
#   visitor's browser downloads that file. Anything in it is public.
#
#   These values are only usable by a SERVER. A static site has no
#   server, so today they're a template for when you add one.
#
# IF A SECRET EVER LANDS IN GIT
#   Deleting it in a later commit does NOT remove it — Git history is
#   permanent. The only real fix is to change the secret at the
#   provider. That is why .gitignore comes before commit #1.
# ===================================================================

# ---- Email (contact + newsletter) ---------------------------------
# Pick ONE provider.
EMAIL_PROVIDER=formspree

# Formspree — easiest, no server needed. Free tier available.
# This endpoint is safe to expose; the others below are NOT.
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# SendGrid — needs your own server to call it.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@yourdomain.com

# Mailgun — also needs a server.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Where contact form messages should be delivered
CONTACT_TO_EMAIL=you@yourdomain.com

# ---- Analytics ------------------------------------------------------
# Google Analytics 4 measurement ID. Not secret, but keep it together
# with the rest of the configuration.
GA_MEASUREMENT_ID=

# ---- Maps ------------------------------------------------------------
# Google Maps API key.
# IMPORTANT: restrict this key to your domain in the Google Cloud
# console. An unrestricted key can be copied from your page and used
# by anyone — and billed to you.
GOOGLE_MAPS_API_KEY=

# ---- Ada (server-side only — never put these in js/) ----------------
# Ada talks to any OpenAI-compatible API. Groq's free tier works great:
#   1. Create a key at https://console.groq.com
#   2. Paste it below as AI_API_KEY
# Without a key, Ada answers from the written notes built into the site.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1

# ---- Site stats (the /backend dashboard reads this) -----------------
# Any long random string. Must match SEMICOLON_STATS_TOKEN on the
# Cosmos server so it may read the summary. Leave empty to disable.
SEMICOLON_ADMIN_TOKEN=
AI_MODEL=openai/gpt-oss-120b
ADA_VISITOR_NAME=AnshX

# ---- Future backend --------------------------------------------------
# Only needed once you add a server (see the Cosmos v2 roadmap for
# what that involves).
DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
PORT=3000
