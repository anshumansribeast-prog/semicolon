# Semicolon environment template — never commit the real .env
EMAIL_PROVIDER=formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@yourdomain.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=you@yourdomain.com
GA_MEASUREMENT_ID=
GOOGLE_MAPS_API_KEY=

# Ada primary model (server-side only)
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
ADA_VISITOR_NAME=AnshX

# Optional Ada fallback
ADA_FALLBACK_API_URL=
ADA_FALLBACK_API_KEY=
ADA_FALLBACK_MODEL=

# Personal OS control plane
# Required to access /api/personal/* and the command center.
# Generate a long random value; never put it in frontend source.
SEMICOLON_ADMIN_TOKEN=
PERSONAL_OS_DB=
BEAST_MODEL=

DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
PORT=3000
