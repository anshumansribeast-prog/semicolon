# ===================================================================
# WRITE THIS FILE BEFORE YOUR FIRST COMMIT.
#
# Once something is committed it is in the history permanently.
# Deleting the file later does NOT remove it — it stays in every past
# commit. If a password or API key ever lands in Git, the only real
# fix is to change the password.
#
# That is why this file comes first, not later.
# ===================================================================

# Secrets — never, ever commit.
# .env.example IS committed on purpose: it is a template with no real
# values, so a new person can see which settings exist.
.env
.env.local
.env.*.local

# Netlify's local link file. It records which site this folder deploys
# to. Keeping it out of Git stops it silently pointing a deploy at the
# wrong site — which has already happened once in this project.
.netlify/

# Dependencies. This project has none, and that is deliberate.
node_modules/

# Build output. semicolon-deploy/ is generated by copying files out of
# here; it lives outside this folder, so it is not Git's problem.
dist/
build/

# Logs
*.log
npm-debug.log*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini
